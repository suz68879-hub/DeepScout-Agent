{
  "name": "aigc",
  "version": "1.6.0",
  "license": "BSD-3-Clause",
  "private": true,
  "dependencies": {
    "@arco-design/web-react": "^2.65.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@volcengine/rtc": "~4.66.20",
    "echarts": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3",
    "react-router": "^6.3.0",
    "react-router-dom": "^6.3.0",
    "redux": "^5.0.1",
    "uuid": "^8.3.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx --quiet",
    "eslint": "eslint  src/ --fix --cache --quiet --ext .js,.jsx,.ts,.tsx",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "stylelint": "stylelint 'src/**/*.less' --fix",
    "pre-commit": "npm run eslint && npm run stylelint",
    "e2e": "playwright test",
    "e2e:dev": "vite --mode e2e",
    "e2e:serve": "vite build --mode e2e && vite preview"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.4",
    "@types/node": "^20",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/react-helmet": "^6.1.11",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^29.1.1",
    "less": "^4.9.0",
    "postcss-less": "^6.0.0",
    "prettier": "^2.7.1",
    "stylelint": "^14.9.1",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^26.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
