{
  "annotations": {"list": []},
  "description": "PostgreSQL、Redis、RabbitMQ、外部 AI/ASR/RTC 与遥测管道。",
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {"title": "Dependency logs", "type": "link", "url": "/explore?orgId=1&left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{service_name=\\\"$service\\\",environment=\\\"$environment\\\"} | json\"}]}"},
    {"title": "Dependency traces", "type": "link", "url": "/explore?orgId=1&left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{resource.service.name=\\\"$service\\\" && span.external.provider!=nil}\"}]}"}
  ],
  "panels": [
    {"id": 1, "title": "PostgreSQL pool in use", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "db_pool_in_use{environment=\"$environment\",service=\"$service\"}", "legendFormat": "connections"}]},
    {"id": 2, "title": "Redis errors", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (operation,error_type) (rate(redis_operation_errors_total{environment=\"$environment\",service=\"$service\"}[5m]))", "legendFormat": "{{operation}} / {{error_type}}"}]},
    {"id": 3, "title": "RabbitMQ queue messages", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (queue) (rabbitmq_queue_messages_ready{environment=\"$environment\",queue=~\"deepscout.*\"})", "legendFormat": "{{queue}}"}]},
    {"id": 4, "title": "External dependency p95", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le,provider,operation) (rate(external_request_duration_seconds_bucket{environment=\"$environment\",service=\"$service\"}[10m])))", "legendFormat": "{{provider}} / {{operation}}"}]},
    {"id": 5, "title": "External outcomes", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (provider,outcome) (rate(external_request_duration_seconds_count{environment=\"$environment\",service=\"$service\"}[5m]))", "legendFormat": "{{provider}} / {{outcome}}"}]},
    {"id": 6, "title": "Telemetry exporter drops", "type": "timeseries", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (data_type) (rate(otelcol_exporter_send_failed_spans_total{environment=\"$environment\"}[5m]))", "legendFormat": "traces"}, {"expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{environment=\"$environment\"}[5m]))", "legendFormat": "metrics"}, {"expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{environment=\"$environment\"}[5m]))", "legendFormat": "logs"}]}
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["deepscout", "dependencies", "slo"],
  "templating": {"list": [
    {"name": "environment", "label": "Environment", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(external_request_duration_seconds_count, environment)", "refresh": 1},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(external_request_duration_seconds_count{environment=\"$environment\"}, service)", "refresh": 1}
  ]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "DeepScout / Dependencies",
  "uid": "deepscout-dependencies",
  "version": 1
}
