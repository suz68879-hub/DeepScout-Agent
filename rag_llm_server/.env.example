# 复制本文件为 .env 并填入你自己的火山引擎凭证（.env 已被 git 忽略）
# 火山引擎 OpenAPI 凭证（调用 RTC/知识库 OpenAPI）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_ACCOUNT_ID=

# RTC 应用
RTC_APP_ID=
RTC_APP_KEY=

# ASR / TTS 语音服务 AppId
ASR_APP_ID=
TTS_APP_ID=

# 火山方舟 LLM
ARK_ENDPOINT_ID=
ARK_API_KEY=

# 知识库
KB_COLLECTION_NAME=dw_ai
KB_PROJECT_NAME=default

# 本服务对外地址（使用 RTC 时必填，需公网可达；缺失时 StartVoiceChat 返回 503）
SERVER_URL=

# 浏览器跨域来源（逗号分隔）与调试路由开关
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_DEBUG_ROUTES=false

# 认证 Cookie；HTTPS 生产环境必须设为 true
AUTH_COOKIE_SECURE=false

# 仅旧库存在无归属历史数据时必填；重复启动不会重置该管理员密码
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# P3 后端 Agent：各 Agent 独立端点（不配置则回落 ARK_ENDPOINT_ID）
ARK_INTERVIEWER_ENDPOINT_ID=
ARK_PLANNER_ENDPOINT_ID=
ARK_EVALUATOR_ENDPOINT_ID=
ARK_REPORTER_ENDPOINT_ID=
ARK_RESUME_ENDPOINT_ID=
ARK_TEXTSQL_ENDPOINT_ID=
ARK_RECORDING_ANALYZER_ENDPOINT_ID=

# 视觉模型（简历扫描件 OCR）与 embedding 端点
ARK_VISION_ENDPOINT_ID=
ARK_EMBEDDING_ENDPOINT_ID=

# embedding 多厂商兼容（OpenAI 兼容协议；未配置时回落 ARK_API_KEY + ARK_EMBEDDING_ENDPOINT_ID）
# 阿里百炼示例：EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#              EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# RAG：llamaindex（本地索引，默认）/ volc_kb（火山云知识库）
RAG_PROVIDER=
RAG_SIMILARITY_THRESHOLD=

# 数据存储；开发默认保持 SQLite，生产环境使用 postgres
STORAGE_BACKEND=sqlite
DATABASE_PATH=data/interview.db
DATABASE_URL=
ANALYTICS_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
FILE_STORAGE_DIR=

# P6：TOS 对象存储（录音/简历原文件云存储；缺失时报告文件回落本地）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=

# P6：豆包语音「录音文件识别大模型版」API Key（火山控制台语音技术控制台）
ASR_FILE_API_KEY=

# RTC 回调验签密钥（启动必填）
RTC_CALLBACK_SECRET=
# 运行环境与日志（production/test 固定使用 json；本地可显式改为 text）
APP_ENV=development
LOG_FORMAT=json
